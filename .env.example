# =============================================================================
# Template Konfigurasi 6-Agent Trading Desk (.env.example)
# =============================================================================
# Cara pakai:
#   1. Salin file ini menjadi `.env` (di root repo atau `desk/.env`):
#        cp .env.example .env && chmod 600 .env
#   2. Isi variabel sesuai tahap yang sedang Anda jalankan.
#   3. File `.env` sudah masuk `.gitignore` dan TIDAK akan ikut ter-commit ke Git.
#   4. JANGAN PERNAH mengisi private key wallet utama — selalu gunakan BURNER WALLET!
# =============================================================================

# --- TAHAP 1: Paper Mode + Data Pasar Live (--mode live, PAPER=True) --------
# Biarkan `paper` selama pengujian. `DESK_BIND` default aman di `127.0.0.1`.
DESK_EXECUTION_MODE=paper
DESK_BIND=127.0.0.1
DESK_PORT=8788
# Opsional: set token tetap untuk login dashboard (jika kosong, dibuat otomatis di desk/data/.auth_token)
# DESK_AUTH_TOKEN=ganti-dengan-token-panjang-acak

# Opsional: aktifkan sentimen X/Twitter via Grok saat memakai `--grok`
# XAI_API_KEY=
# DESK_GROK_MODEL=grok-4.7
# Cooldown minimal antar panggilan API xAI Grok (detik). Misal 3000 = maks 1x tiap 50 menit (Risk tetap cek harga 0 token)
# DESK_GROK_COOLDOWN_SEC=3000

# --- TAHAP 2: Dry-Run simulateTransaction (tanpa private key) ----------------
# Gunakan RPC Solana stabil (Helius / QuickNode / Triton / mainnet-beta)
SOLANA_RPC_URL=
# Opsional untuk `--simulate` tanpa `--pubkey`
SOLANA_PUBLIC_KEY=

# --- TAHAP 3: Live On-Chain dengan Burner Wallet & Double-Lock ---------------
# Untuk mengaktifkan eksekusi uang asli, ubah DESK_EXECUTION_MODE=live DAN isi keempat nilai ini:
# DESK_EXECUTION_MODE=live
DESK_LIVE_CONFIRM=
# Format yang didukung: base58 private key, JSON array [..], atau path file ~/.config/solana/burner.json
SOLANA_PRIVATE_KEY=
# Batas modal maksimal per transaksi entry saat live (default aman: $5.00)
DESK_MAX_LIVE_TRADE_USD=5.0
DESK_MIN_SOL_FOR_GAS=0.01

# Pengaturan eksekusi swap Jupiter (Tahap 2 & Tahap 3)
DESK_SLIPPAGE_BPS=150
DESK_PRIORITY_FEE_LAMPORTS=50000
DESK_TX_CONFIRM_TIMEOUT_SEC=45
